# Copy to .env and fill in local values. Never commit real secrets.

# Local PostgreSQL (Stage 2B). For Neon later, replace with the Neon connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payledger

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
ACTIVATION_RATE_LIMIT_MAX=10
